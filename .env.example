# ============================================================
# 谱合产教 · 环境变量模板（复制为 .env.local 后填写）
# ⚠️ 严禁把真实密钥提交到公开仓库，.env* 已在 .gitignore 中排除
# ============================================================

# --- 大模型服务商（v4 起推荐：魔搭 ModelScope）---
# 魔搭 API-Inference 提供 OpenAI 兼容接口，注册用户可免费调用开源模型。
# ① 注册/登录 https://modelscope.cn
# ② 绑定阿里云账号并完成实名认证（未实名无法调用 API-Inference）
# ③ 在 https://modelscope.cn/my/myaccesstoken 获取 SDK Token（形如 ms-xxxxxxxx）
AI_PROVIDER=modelscope
MODELSCOPE_SDK_TOKEN=

# --- 可选：覆盖预设（留空即用 AI_PROVIDER 的默认值）---
# 魔搭默认：base_url = https://api-inference.modelscope.cn/v1
#           model    = Qwen/Qwen3-Coder-30B-A3B-Instruct
# 常用模型（会迭代，以模型页右侧「API-Inference 范例」为准）：
#   Qwen/Qwen3-235B-A22B-Instruct-2507   综合推理更强
#   deepseek-ai/DeepSeek-V3.2            中文长文本/报告
#   Qwen/Qwen2.5-VL-72B-Instruct        多模态视觉（下面 VISION_* 用）
# AI_BASE_URL=
# AI_MODEL=

# --- 其它服务商：把 AI_PROVIDER 改成对应值并填写 AI_API_KEY ---
# deepseek : https://api.deepseek.com/v1              / deepseek-chat
# zhipu    : https://open.bigmodel.cn/api/paas/v4     / glm-4-flash
# qwen     : https://dashscope.aliyuncs.com/compatible-mode/v1 / qwen-plus
# openai   : https://api.openai.com/v1                / gpt-4o-mini
# custom   : 自行填写 AI_BASE_URL + AI_MODEL（任意 OpenAI 兼容网关）
# AI_PROVIDER=deepseek
# AI_API_KEY=

# --- 多模态视觉（可选，用于上传图片/截图抽取岗位技能）---
# 魔搭用户可复用同一个 SDK Token，只需指定 VL 模型 ID：
# VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# VISION_BASE_URL=
# VISION_API_KEY=
# 不配置时图片上传走「演示模式」本地占位解析，功能链路仍完整。

# --- 是否强制使用本地确定性引擎 ---
# true = 完全离线演示，不消耗任何 token（评审断网/无密钥时的保底方案）
DEMO_MODE=false

# --- 魔搭创空间 Docker 部署专用（本地开发无需设置）---
# 创空间要求服务监听 7860，Dockerfile 已内置 PORT/HOSTNAME
# PORT=7860
# HOSTNAME=0.0.0.0

# --- Xiaomi-OCR-0 本地文档解析（可选，v6 新增）---
# 与上面的大模型配置相互独立：仅用于 /ocr 页的图片 → 结构化文本 → RAG 入库。
# 也可直接在网页 /ocr 里填写并启用（密钥只存服务端内存，重启失效）。
# 官方权重走 vLLM / SGLang：http://127.0.0.1:8000/v1
# Ollama 实验版：http://127.0.0.1:11434/v1 + longwayxu/xiaomi-ocr-0:bf16
# OCR_BASE_URL=http://127.0.0.1:8000/v1
# OCR_MODEL=SeerRay-Lab/Xiaomi-OCR-0
# OCR_API_KEY=            # 本地网关免密钥，留空即可；外部端点必须 https

# 可选：服务端日志级别
LOG_LEVEL=info

# ============================================================
# 额度提醒：魔搭免费推理采用动态限流与「魔粒」额度体系，
# 每日额度以控制台为准；遇到 429 时项目会自动退避重试 3 次，
# 仍失败则自动降级本地引擎，不影响演示。详见 docs/07。
# ============================================================
